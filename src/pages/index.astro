---
import products from '../data/products.json';
const origin='https://saas.planet-x.co/';
const title='planet.X Apps | Seven practical SaaS tools in one directory';
const description='Explore seven planet.X apps for client delivery, field operations, invoice follow-up, smart forms, software licensing, customer support and status monitoring.';
const faq=[
['Which app is right for me?','Choose the workflow first. Each card shows the purpose, best-fit audience, capabilities and direct pricing for that application.'],
['Can I log into all seven apps here?','No. Every app maintains its own account, workspace and billing. Open an app to sign in on its own website.'],
['Which tools offer free plans?','FormForge, CrateKeys, RelayDesk and StatusPost advertise free entry plans. Check each product pricing page for current limits and trial conditions.'],
['Are these all planet.X products?','This is the dedicated business SaaS directory. The main planet.X website also includes other apps, creator tools, music and custom development services.'],
['Can planet.X build a custom workflow for my team?','Yes. The main planet.X services section describes software development, websites, automation and workflow design.']
];
const org={'@type':'Organization','@id':'https://www.planet-x.co/#organization',name:'planet.X',url:'https://www.planet-x.co/'};
const graph=[org,{'@type':'WebSite','@id':origin+'#website',name:'planet.X Apps',url:origin,publisher:{'@id':org['@id']}},{'@type':'CollectionPage','@id':origin+'#page',name:'planet.X SaaS applications',url:origin,description,mainEntity:{'@id':origin+'#list'}},{'@type':'ItemList','@id':origin+'#list',numberOfItems:products.length,itemListOrder:'https://schema.org/ItemListUnordered',itemListElement:products.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.name,url:p.home,item:{'@id':p.home+'#software'}}))},{'@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))},...products.map(p=>({'@type':'SoftwareApplication','@id':p.home+'#software',name:p.name,description:p.purpose,url:p.home,applicationCategory:'BusinessApplication',operatingSystem:'Web browser',publisher:{'@id':org['@id']},offers:[...(p.free?[{'@type':'Offer',price:'0',priceCurrency:'USD',url:p.pricing,name:'Free entry tier'}]:[]),{'@type':'Offer',price:String(p.monthly),priceCurrency:'USD',url:p.pricing,description:'Monthly billing; check current product terms'},{'@type':'Offer',price:String(p.annual),priceCurrency:'USD',url:p.pricing,description:'Annual billing; check current product terms'}]}))];
const actions=[['Client projects','client-console'],['Technician jobs','dispatchloop'],['Unpaid invoices','ledgerloop'],['Conditional forms','formforge'],['License keys','cratekeys'],['Customer tickets','relaydesk'],['Uptime + incidents','statuspost']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0a0714"/>
<title>{title}</title><meta name="description" content={description}/><meta name="robots" content="index,follow,max-image-preview:large"/><link rel="canonical" href={origin}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="planet.X"/><meta property="og:locale" content="en_US"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={origin}/><meta property="og:image" content={origin+'og.svg'}/><meta property="og:image:alt" content="planet.X apps directory with seven software products"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={origin+'og.svg'}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph})}/>
</head>
<body>
<a class="skip" href="#applications">Skip to applications</a>
<div class="ambient ambient-a" aria-hidden="true"></div><div class="ambient ambient-b" aria-hidden="true"></div>
<header class="masthead"><div class="wrap head-inner"><a class="logo" href="https://www.planet-x.co/" aria-label="planet.X company homepage"><span class="x" aria-hidden="true">X</span><span>planet<span class="dot">.</span>X <small>/ apps</small></span></a><nav aria-label="SaaS Hub navigation"><a href="#applications">Apps</a><a href="#compare">Compare</a><a href="#faq">FAQ</a></nav><a class="header-action" href="#applications">Explore all seven <span aria-hidden="true">↗</span></a></div></header>
<main>
<section class="hero wrap" aria-labelledby="headline"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> PLANET.X / APPLICATION DIRECTORY <span class="eyebrow-trail">001 — 007</span></p><h1 id="headline">Your workflow.<br/><span>More capable.</span></h1><p class="intro">Seven focused applications. From client delivery and field operations to smarter forms, licenses, customer support and service health. Find your fit, then get straight to work.</p><div class="hero-actions"><a class="button primary" href="#applications">Explore the apps <span aria-hidden="true">↗</span></a><a class="button quiet" href="#compare">Compare by task <span aria-hidden="true">↓</span></a></div><p class="hero-foot">Each product has its own secure workspace and pricing. No additional Hub account.</p></div><div class="hero-visual" aria-hidden="true"><div class="rings"></div><div class="x-hero">X</div><div class="floating top"><span>◎</span> BUILT FOR WORK</div><div class="floating bottom"><span>◇</span> SEVEN APPS / ONE DIRECTORY</div></div></section>
<section class="quick wrap" aria-label="Quick product shortcuts"><span>JUMP TO</span><div>{products.map(p=><a href={'#'+p.id}>{p.name}</a>)}</div></section>
<section id="applications" class="section wrap"><div class="section-header"><div><p class="kicker">01 / PRODUCT COLLECTION</p><h2>Find your workflow<span class="dot">.</span></h2><p>Distinct tools. Clear purpose. Your choice.</p></div><span class="section-count">{String(products.length).padStart(2,'0')} APPLICATIONS</span></div>
<div class="cards">{products.map((p,i)=><article class="card" id={p.id}><div class="card-top"><span class="monogram" aria-hidden="true">{p.initials}</span><span class="index">{String(i+1).padStart(2,'0')} / {String(products.length).padStart(2,'0')}</span></div><p class="tag">{p.tag}</p><h3>{p.name}</h3><p class="summary">{p.purpose}</p><div class="rule"></div><p class="best"><strong>BEST FOR</strong> {p.audience}</p><ul class="features">{p.features.map(f=><li>{f}</li>)}</ul><div class="push"></div><div class="plan"><div><span class="overline">{p.free?'FREE PLAN AVAILABLE':'STARTING AT'}</span><p class="price">{p.free?'Free':'$'+p.monthly}<small>{p.free?' + paid tiers':' / month'}</small></p><p class="annual">{p.free?'Paid tiers: ':''}&#36;{p.monthly}/mo or &#36;{p.annual}/yr</p>{p.free&&<p class="detail">{p.free}</p>}{p.trial&&<p class="detail">{p.trial}</p>}</div><a class="pricing-link" href={p.pricing} target="_blank" rel="noopener noreferrer" aria-label={'See '+p.name+' prices'}>Pricing ↗</a></div><div class="buttons"><a href={p.home} target="_blank" rel="noopener noreferrer">Explore product ↗</a><a href={p.app} target="_blank" rel="noopener noreferrer">Open app ↗</a></div></article>)}</div><p class="disclaimer">All prices USD. Confirm current billing, trial conditions and eligibility on each product’s pricing page.</p>
</section>
<section id="compare" class="compare-section"><div class="wrap section"><div class="section-header"><div><p class="kicker">02 / WORKFLOW MATCHING</p><h2>Start with the job<span class="dot">.</span></h2><p>Choose the task. Go directly to the right app.</p></div></div><div class="comparison"><table><thead><tr><th scope="col">WHAT YOU NEED</th><th scope="col">BEST MATCH</th><th scope="col">ENTRY PLAN</th><th scope="col">OPEN</th></tr></thead><tbody>{actions.map(([task,id])=>{const p=products.find(x=>x.id===id);return p?<tr><td>{task}</td><td><a href={'#'+p.id}>{p.name}</a></td><td>{p.free?'Free entry': '$'+p.monthly+'/mo'}</td><td><a href={p.app} target="_blank" rel="noopener noreferrer" aria-label={'Open '+p.name}>Launch ↗</a></td></tr>:null})}</tbody></table></div></div></section>
<section id="faq" class="section wrap faq"><div><p class="kicker">03 / GOOD TO KNOW</p><h2>The essentials<span class="dot">.</span></h2><p>Clear answers before you choose.</p></div><div class="questions">{faq.map(([q,a],i)=><details open={i===0}><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
<section class="wrap cta-section"><div class="cta"><div><p class="kicker">BUILT BY PLANET.X</p><h2>Need something<br/>entirely your own?</h2><p>Explore custom websites, dashboards and workflow software from planet.X.</p></div><a class="button primary" href="https://www.planet-x.co/services">Explore services ↗</a></div></section>
</main>
<footer><div class="wrap footer"><div><a class="logo" href="https://www.planet-x.co/"><span class="x" aria-hidden="true">X</span> planet<span class="dot">.</span>X</a><p>Independent tools for better work.</p></div><div><span>APPLICATIONS</span>{products.map(p=><a href={p.home} target="_blank" rel="noopener noreferrer">{p.name}</a>)}</div><div><span>EXPLORE</span><a href="https://www.planet-x.co/">planet.X</a><a href="https://www.planet-x.co/services">Services</a><a href="https://www.planet-x.co/services/showcase">Showcase</a></div></div><div class="wrap bottom"><span>© {new Date().getFullYear()} planet.X</span><span>SEVEN TOOLS. DIRECT ACCESS.</span><a href="#headline">Back to top ↑</a></div></footer>
</body>
</html>
<style is:global>
:root{color-scheme:dark;--bg:#090713;--panel:#151022;--border:#ffffff1d;--txt:#f6f1ff;--muted:#aaa1bb;--pink:#ff4fba;--violet:#a77bff;--cyan:#5ee5f1;--display:ui-sans-serif,system-ui,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--txt);font-family:var(--display);line-height:1.6;overflow-x:hidden}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid var(--cyan);outline-offset:3px}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;z-index:9999;background:#fff;color:#000;padding:10px}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.dot{color:var(--pink)}.ambient{position:absolute;pointer-events:none;z-index:-1;filter:blur(75px);opacity:.18;border-radius:50%}.ambient-a{width:520px;height:520px;top:100px;left:-250px;background:var(--pink)}.ambient-b{width:650px;height:650px;top:250px;right:-330px;background:#6943d9}
.masthead{position:sticky;top:0;z-index:20;border-bottom:1px solid var(--border);background:#0a0714ed;backdrop-filter:blur(18px)}.head-inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}.logo{display:inline-flex;align-items:center;gap:8px;font-size:22px;font-weight:850;letter-spacing:-.065em;white-space:nowrap}.x{width:39px;height:39px;border-radius:9px;background:linear-gradient(135deg,var(--pink),var(--violet) 55%,var(--cyan));display:inline-grid;place-items:center;font-size:26px;font-weight:1000;color:#070412;transform:skew(-5deg)}.logo small{font-size:11px;font-weight:600;color:#8a7f9a;letter-spacing:.06em}.head-inner nav{display:flex;gap:32px}.head-inner nav a{font-size:12px;font-weight:750;color:#c7bfd5}.head-inner nav a:hover,.footer a:hover{color:var(--cyan)}.header-action{font-size:12px;font-weight:800;padding:11px 17px;border:1px solid #9a6cb969;border-radius:7px;background:#ffffff0a}.header-action:hover{border-color:var(--cyan)}
.hero{min-height:610px;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:42px;padding-block:90px 95px}.eyebrow,.kicker,.overline,.section-count,.index,.tag{font-size:10px;letter-spacing:.14em;font-weight:850}.eyebrow,.kicker{color:var(--pink)}.eyebrow-trail{margin-left:12px;color:#8e7ba9}.live-dot{display:inline-block;width:8px;height:8px;background:var(--cyan);border-radius:100%;margin-right:9px;box-shadow:0 0 15px var(--cyan)}h1,h2,h3,p{margin-top:0}.hero h1{font-size:clamp(45px,6.6vw,90px);line-height:1.02;letter-spacing:-.07em;font-weight:900;margin:25px 0}.hero h1 span{background:linear-gradient(100deg,var(--pink),var(--violet),var(--cyan));background-clip:text;-webkit-text-fill-color:transparent}.intro{max-width:630px;font-size:17px;color:#beb5cd;line-height:1.85}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.button{min-height:47px;display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:13px 21px;border-radius:7px;font-size:12px;font-weight:850}.primary{background:linear-gradient(110deg,#ed3da8,#8553f2,#42c6d6);color:#080510}.quiet{background:#ffffff0b;border:1px solid var(--border)}.button:hover{filter:brightness(1.12)}.hero-foot{font-size:12px;color:#81788f;margin:22px 0}.hero-visual{height:400px;display:grid;place-items:center;position:relative}.rings,.rings:before,.rings:after{position:absolute;border-radius:50%;border:1px solid #9b70dd33}.rings{width:350px;height:350px}.rings:before,.rings:after{content:"";inset:37px}.rings:after{inset:89px}.x-hero{font-size:230px;font-weight:1000;font-style:italic;line-height:1;color:transparent;background:linear-gradient(155deg,var(--pink),var(--violet) 52%,var(--cyan));-webkit-background-clip:text;background-clip:text;filter:drop-shadow(0 0 50px #bb4aef65)}.floating{position:absolute;padding:12px 14px;background:#1e1832e0;border:1px solid #b98cdc70;border-radius:7px;box-shadow:0 18px 45px #0008;font-size:10px;letter-spacing:.09em}.floating span{font-size:19px;color:var(--cyan);vertical-align:middle}.floating.top{top:45px;right:0;transform:rotate(5deg)}.floating.bottom{bottom:40px;left:0;transform:rotate(-4deg)}
.quick{display:flex;align-items:center;gap:30px;padding:18px 0;border-block:1px solid var(--border)}.quick>span{white-space:nowrap;font-size:10px;letter-spacing:.13em;color:#87798f}.quick>div{display:flex;flex-wrap:wrap;gap:9px}.quick a{padding:6px 10px;border:1px solid #ffffff27;border-radius:6px;font-size:11px;color:#d5cde1}.quick a:hover{border-color:var(--cyan)}.section{padding-block:105px}.section-header{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:34px}.section-header h2,.faq h2,.cta h2{font-size:clamp(32px,4.7vw,53px);letter-spacing:-.05em;line-height:1.13;margin:10px 0}.section-header p:not(.kicker),.faq>div>p:not(.kicker){color:var(--muted);font-size:14px}.section-count{color:#988aaa;white-space:nowrap}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.card{display:flex;flex-direction:column;padding:25px;border:1px solid #3b2b4e;border-radius:15px;background:linear-gradient(155deg,#1b132a,#100d1b);min-width:0;scroll-margin-top:100px;transition:border .18s,transform .18s}.card:nth-child(3n+2){background:linear-gradient(155deg,#121d2b,#100d1b)}.card:nth-child(3n){background:linear-gradient(155deg,#19142b,#100d1b)}.card:hover{border-color:#a56cbe;transform:translateY(-3px)}.card-top{display:flex;justify-content:space-between;align-items:start}.monogram{width:58px;height:58px;display:grid;place-items:center;border:1px solid #f868b775;border-radius:12px;color:#ff99d5;background:#ff4fba12;font-size:21px;font-weight:850}.card:nth-child(even) .monogram{color:#8debf3;border-color:#67dbe270;background:#5ee5f114}.index{color:#817092}.tag{margin:24px 0 7px;color:#cb8de2}.card h3{font-size:30px;letter-spacing:-.04em;line-height:1.18;margin:0 0 9px}.summary{font-size:13px;color:#c2b8d1;line-height:1.75;min-height:75px}.rule{height:1px;background:var(--border);margin:10px 0 19px}.best{font-size:12px;line-height:1.6;color:#b6a7c4;min-height:46px}.best strong{font-size:10px;letter-spacing:.08em;color:#e6d7f2;margin-right:5px}.features{padding:0;list-style:none;margin:0 0 24px}.features li{font-size:12px;color:#c8bed7;padding:5px 0 5px 18px;position:relative}.features li:before{content:'✓';position:absolute;left:0;color:var(--cyan)}.push{flex:1}.plan{display:flex;gap:8px;justify-content:space-between;border-top:1px solid var(--border);padding-top:16px}.overline{color:#9385a8}.price{font-size:29px;font-weight:850;line-height:1.25;margin:6px 0 3px}.price small{font-size:12px;color:#ac9ebc;font-weight:550}.annual,.detail{color:#a79aaf;font-size:11px;margin:4px 0}.detail{color:#d0b1da}.pricing-link{font-size:12px;color:#edc9fc;text-decoration:underline;text-underline-offset:4px}.buttons{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:19px}.buttons a{min-height:45px;display:grid;place-items:center;border-radius:7px;font-size:11px;font-weight:800;text-align:center;padding:9px}.buttons a:first-child{background:#ffffff11;border:1px solid #ffffff24}.buttons a:last-child{background:linear-gradient(110deg,#ac50ba,#624ad8)}.buttons a:hover{filter:brightness(1.2)}.disclaimer{font-size:11px;color:#8d819e;margin-top:18px}
.compare-section{background:#100b1c;border-block:1px solid var(--border)}.comparison{overflow-x:auto;border:1px solid #42334d;border-radius:13px}.comparison table{border-collapse:collapse;width:100%;min-width:640px}.comparison th{text-align:left;background:#211730;color:#a9a0bc;font-size:10px;letter-spacing:.1em;padding:18px}.comparison td{font-size:13px;color:#cfc3dc;padding:18px;border-top:1px solid #ffffff16}.comparison td a{color:#80eaf1;font-weight:750}.comparison tr:hover{background:#ffffff09}.faq{display:grid;grid-template-columns:1fr 1.4fr;gap:55px}.questions details{border-bottom:1px solid #ffffff26}.questions details:first-child{border-top:1px solid #ffffff26}.questions summary{padding:19px 0;cursor:pointer;font-size:14px;font-weight:750;list-style:none;display:flex;justify-content:space-between;gap:18px}.questions summary::-webkit-details-marker{display:none}.questions summary span{font-size:23px;color:var(--cyan);line-height:1}.questions details[open] summary span{transform:rotate(45deg)}.questions details p{font-size:13px;line-height:1.8;color:#a99db8}.cta-section{padding-bottom:100px}.cta{display:flex;justify-content:space-between;align-items:center;gap:30px;background:radial-gradient(ellipse at 70% 5%,#62348455,transparent 65%),linear-gradient(120deg,#24132c,#130c21);border:1px solid #7c4b8c;border-radius:17px;padding:50px}.cta p:not(.kicker){color:#bcafca;font-size:14px;max-width:500px}.cta h2{font-size:38px}.cta .button{white-space:nowrap}footer{background:#090711;border-top:1px solid var(--border)}.footer{display:grid;grid-template-columns:2fr 1fr 1fr;gap:45px;padding-block:60px}.footer>div{display:flex;flex-direction:column;align-items:flex-start;gap:10px}.footer>div:first-child p{font-size:12px;color:#85778f;margin:3px 0}.footer>div:not(:first-child) span{color:#9381aa;font-size:10px;font-weight:800;letter-spacing:.1em}.footer a:not(.logo){font-size:12px;color:#bcaecb}.bottom{padding:22px 0;display:flex;gap:20px;justify-content:space-between;border-top:1px solid var(--border);font-size:10px;color:#90829e}.bottom a{color:#d9c0e2}
@media(max-width:1000px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{grid-template-columns:1fr .7fr}.hero-visual{transform:scale(.8)}.faq{gap:30px}.head-inner nav{gap:15px}}
@media(max-width:720px){.wrap{width:min(100% - 32px,1160px)}.head-inner{min-height:68px}.logo{font-size:19px}.logo small{display:none}.head-inner nav{gap:12px}.head-inner nav a{font-size:11px}.header-action{display:none}.hero{display:block;min-height:auto;padding:65px 0 30px}.hero h1{font-size:clamp(43px,11vw,68px)}.intro{font-size:15px}.hero-visual{height:230px;transform:scale(.55);margin-block:-18px}.quick{display:block}.quick>div{margin-top:12px}.section{padding-block:72px}.cards{grid-template-columns:1fr}.summary,.best{min-height:0}.section-count{display:none}.faq{display:block}.questions{margin-top:30px}.cta{padding:29px;display:block}.cta .button{margin-top:20px}.footer{grid-template-columns:1fr 1fr;gap:35px}.footer>div:first-child{grid-column:span 2}.bottom{flex-wrap:wrap}}
@media(max-width:380px){.head-inner nav{gap:9px}.head-inner nav a{font-size:10px}.hero-visual{margin-inline:-40px}.buttons{grid-template-columns:1fr}.footer{gap:22px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
</style>